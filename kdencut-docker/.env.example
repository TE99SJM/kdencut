# Copy to .env and edit:  cp .env.example .env
# User/group that owns your files on the server (run: id)
PUID=1000
PGID=1000
TZ=America/Chicago

# Browser login (basic auth). Set both. Only use on your home network / Tailscale.
CUSTOM_USER=samuel
PASSWORD=change-me

# Where KdenCut keeps settings + projects, and where your videos are
CONFIG_DIR=./config
MEDIA_DIR=./media

# Ports on the server (3004/3005 are used by your current Kdenlive container)
HTTP_PORT=3006
HTTPS_PORT=3007

# Build threads (0 = all cores, use 2 on low-RAM servers)
BUILD_JOBS=0
